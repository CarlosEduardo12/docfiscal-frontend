{
  "extends": ["next/core-web-vitals", "prettier"],
  "plugins": ["prettier"],
  "rules": {
    "prettier/prettier": "error",
    "prefer-const": "error"
  },
  "ignorePatterns": [
    "node_modules/", 
    ".next/", 
    "out/",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/__tests__/**/*",
    "src/lib/__tests__/**/*"
  ]
}
